# Copy to .env.backend on the VPS. Never commit the populated file.
TLS_EMAIL=ops@example.com
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CHECKOUT_SIGNING_SECRET=
ALLOWED_ORIGINS=https://www.jersevo.com,https://jersevo.com
SITE_URL=https://www.jersevo.com

# Optional one-shot server-side Fangear catalogue import. Keep the service key
# out of VITE_* variables and never commit a populated env file.
FANGEAR_SOURCE_AUTHORIZED=false
FANGEAR_SOURCE_BASE_URL=https://fangearsport.com
FANGEAR_IMPORT_MEDIA=true
FANGEAR_MEDIA_LIMIT_PER_PRODUCT=12

BACKEND_MAX_BODY_BYTES=20971520
BACKEND_RATE_WINDOW_MS=60000
BACKEND_RATE_LIMIT=180

AI_IMAGE_API_URL=https://api.apikey.fan/v1/images/edits
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=medium
AI_TEXT_API_URL=https://api.apikey.fan/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=gpt-4.1-mini

PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
