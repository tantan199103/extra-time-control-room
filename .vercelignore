# API handlers are retained in the repository for rollback and local tests.
# Production traffic uses the dedicated Node runtime instead of Vercel
# Serverless Functions, which keeps the Hobby plan below its function cap.
api/*.js
!api/sitemap.js
!api/google-merchant-feed.js
!api/ai-listing-copy.js
!api/ai-listing-media.js
!api/newsletter-subscribe.js
!api/ai-preview.js
!api/_exact-image-edit.js
!api/_security.js
!api/_membership.js
# Edge Functions are not deployed in the production Supabase project yet.
# Cloud Run owns the equivalent light routes until that gateway is provisioned.
backend/
supabase/functions/

# Keep local/build artefacts out of the deployment archive.
node_modules
dist
dist-extension
artifacts
.git
.vercel
supabase/.temp
*.local
