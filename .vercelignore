# API handlers are retained in the repository for rollback and local tests.
# Production traffic uses the dedicated Node runtime instead of Vercel
# Serverless Functions, which keeps the Hobby plan below its function cap.
api/*.js
!api/sitemap.js
!api/_security.js
!api/_membership.js
# Edge Functions are not deployed in this production project yet. Keep the
# equivalent lightweight handlers available on Vercel until the Edge gateway
# is provisioned; this prevents cart/member routes from falling through to
# Cloud Run's unknown-route response.
!api/cart-validate.js
!api/member-quote.js
!api/membership-enroll.js
backend/
supabase/functions/
