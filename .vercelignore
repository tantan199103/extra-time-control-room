# API handlers are retained in the repository for rollback and local tests.
# Production traffic uses the dedicated Node runtime instead of Vercel
# Serverless Functions, which keeps the Hobby plan below its function cap.
api/*.js
!api/sitemap.js
!api/_security.js
!api/_checkout.js
!api/_membership.js
# Keep the payment-adjacent fallback in Vercel so the storefront remains
# fail-closed (JSON/no-store) while the dedicated Node runtime is being
# provisioned. Heavy AI/upload routes stay on Node.
!api/payment-config.js
!api/checkout-quote.js
!api/checkout-create.js
!api/payment-capture.js
!api/payment-cancel.js
!api/payment-webhook.js
!api/order-track.js
!api/admin-orders.js
!api/admin-payment-settings.js
backend/
supabase/functions/
