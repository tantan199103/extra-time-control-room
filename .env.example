VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Hybrid API routing. Leave blank to keep same-origin /api fallback locally.
# Edge Functions host ends with /functions/v1 (no trailing slash).
VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
# Node runtime for upload, image processing, AI, admin and payment routes.
VITE_BACKEND_URL=https://api.jersevo.com
# Canonical public origin used for SEO URLs and sitemaps.
VITE_SITE_URL=https://www.jersevo.com
SITE_URL=https://www.jersevo.com

# Server-only AI image edit settings. Never prefix these with VITE_.
# APIKEY.FUN production endpoint. The SLB endpoint disables image generation.
AI_IMAGE_API_URL=https://api.apikey.fan/v1/images/edits
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=medium

# Server-only AI listing writer. Compatible with APIKEY.FUN or another
# OpenAI-style /v1/chat/completions endpoint. Never prefix the key with VITE_.
AI_TEXT_API_URL=https://api.apikey.fan/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini

# Optional server aliases used by authenticated API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required by customer uploads, validated customization requests and private AI
# previews. Server-only: never expose this value with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Node backend CORS allowlist. Comma-separated exact origins, no wildcard.
ALLOWED_ORIGINS=https://www.jersevo.com,https://jersevo.com,http://localhost:5173
BACKEND_MAX_BODY_BYTES=33554432
# Supabase Edge Function -> Node quote gateway (server-side Edge secret).
NODE_BACKEND_URL=https://api.jersevo.com

# Payment provider settings. Public IDs/tokens are saved in pod_store_settings;
# these values are server-only and must never use a VITE_ prefix.
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Meta / Facebook Pixel (Public Tracking ID)
VITE_FACEBOOK_PIXEL_ID=1684842090311448

# TAASS public-catalogue import. Enable only after confirming permission to
# reuse the catalogue. Dry runs do not write to Supabase.
TAASS_SOURCE_AUTHORIZED=false
TAASS_DEFAULT_INVENTORY=1000
TAASS_PRODUCT_LIMIT=25
TAASS_LANGUAGE=en
TAASS_REQUEST_INTERVAL_MS=750
TAASS_REQUEST_RETRIES=3
TAASS_REQUEST_TIMEOUT_MS=30000
TAASS_CONCURRENCY=2
TAASS_IMPORT_MEDIA=false
TAASS_MEDIA_LIMIT_PER_PRODUCT=all
TAASS_MEDIA_TARGET_BYTES=16384
TAASS_MEDIA_BUDGET_BYTES=734003200
TAASS_BATCH_SIZE=25
# Source EUR numeric amounts are stored as USD numeric amounts at 1:1.
