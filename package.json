{
  "name": "extra-time-story-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "audit:hosting": "node scripts/audit-hosting.mjs",
    "audit:gmc": "node scripts/audit-gmc-feed.mjs",
    "generate:merchant-feed": "node scripts/generate-merchant-feed.mjs",
    "audit:taxonomy": "node scripts/audit-catalog-taxonomy.mjs",
    "migrate:taxonomy": "node scripts/migrate-supplemental-taxonomy.mjs",
    "release:taxonomy": "node scripts/release-repaired-taxonomy.mjs",
    "audit:team-assets": "node scripts/audit-team-assets.mjs --write",
    "fetch:team-logos": "node scripts/fetch-team-logos.mjs",
    "import:fangear": "node scripts/import-fangear-catalog.mjs",
    "import:taass": "node scripts/import-taass-catalog.mjs",
    "import:taass:jerseys": "node scripts/import-taass-catalog.mjs --jersey-only",
    "sync:taass": "node scripts/import-taass-catalog.mjs --write",
    "sync:taass:jerseys": "node scripts/import-taass-catalog.mjs --write --jersey-only --media",
    "sync:taass:jerseys:metadata": "node scripts/import-taass-catalog.mjs --write --jersey-only",
    "import:comma": "node scripts/import-comma-catalog.mjs",
    "sync:comma": "node scripts/import-comma-catalog.mjs --write",
    "publish:comma": "node scripts/publish-comma-catalog.mjs",
    "refresh:comma:seo": "node scripts/refresh-comma-seo.mjs",
    "sync:owayo:designer": "node scripts/sync-owayo-designer-assets.mjs",
    "sync:owayo:patterns": "node scripts/sync-owayo-patterns.mjs --write",
    "generate:owayo:catalog": "node scripts/generate-owayo-catalog.mjs",
    "create:owayo:listing": "node scripts/create-owayo-listing.mjs",
    "sync:owayo:families": "node scripts/sync-owayo-family-assets.mjs",
    "create:owayo:families": "node scripts/create-owayo-family-listings.mjs",
    "sync:boombah:designer": "node --env-file-if-exists=.env.local scripts/sync-boombah-designer-assets.mjs --write --owner-confirmed",
    "create:boombah:listings": "node --env-file-if-exists=.env.local scripts/create-boombah-listings.mjs",
    "route:taass": "node scripts/route-taass-catalog.mjs",
    "audit:taass": "node scripts/audit-taass-coverage.mjs",
    "import:fanatics": "node scripts/import-fanatics-catalog.mjs",
    "sync:fanatics": "node scripts/auto-sync-fanatics.mjs",
    "import:lidshd": "node scripts/import-lidshd-catalog.mjs",
    "sync:lidshd": "node scripts/import-lidshd-catalog.mjs --write --media --media-limit 0 --activate --force-stock --stock 1000 --batch-size 250 --concurrency 48 --save-concurrency 20",
    "import:topperz": "node scripts/sync-topperz-catalog.mjs",
    "sync:topperz": "node scripts/sync-topperz-catalog.mjs --write --media --stock 1000",
    "audit:lidshd": "node scripts/audit-lidshd-sync.mjs",
    "dev:extension": "vite build --config extension/vite.config.js --mode development --watch",
    "build:extension": "vite build --config extension/vite.config.js",
    "package:extension": "npm run build:extension && powershell -NoProfile -ExecutionPolicy Bypass -File extension/package.ps1",
    "preview": "vite preview",
    "backend:dev": "node backend/src/server.mjs",
    "backend:start": "node backend/src/server.mjs",
    "backend:docker": "docker build -f backend/Dockerfile -t jersevo-api .",
    "deploy:cloudrun": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/cloudrun/deploy.ps1"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
